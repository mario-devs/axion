# Copiar a .env y rellenar con valores reales.
#
# El motor de anonimización funciona sin claves: solo la llamada final al LLM
# las necesita. Se puede probar el pipeline entero sin configurar nada de esto.

# Google AI Studio -> https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# OpenAI -> https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Orígenes permitidos por CORS, separados por comas.
AXION_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
